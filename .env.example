# =============================================================================
# AI Workspace — Environment Variables
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# =============================================================================

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=aiworkspace
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=aiworkspace

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── Qdrant ────────────────────────────────────────────────────────────────────
# Leave empty to disable API key protection (local dev only)
QDRANT_API_KEY=

# ── Local Inference ───────────────────────────────────────────────────────────
# Choose ONE backend. All expose an OpenAI-compatible API — switching is a URL change only.

# Option 1: Ollama (default — runs in Docker, GPU-accelerated)
LOCAL_INFERENCE_BASE_URL=http://ollama:11434/v1
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Option 2: llama.cpp server (runs in Docker, single GGUF model)
# LOCAL_INFERENCE_BASE_URL=http://llamacpp:8080/v1

# Option 3: LM Studio (native Windows app — NOT in Docker)
# Enable Local Server in LM Studio UI (Local Server tab), then use
# host.docker.internal to reach the Windows host from inside Docker.
# LOCAL_INFERENCE_BASE_URL=http://host.docker.internal:1234/v1


# ── Cloud Provider (OpenRouter — pluggable) ───────────────────────────────────
# Set CLOUD_PROVIDER to switch provider: openrouter | openai | anthropic
CLOUD_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...your-key-here
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_generate_a_strong_random_key
JWT_EXPIRE_MINUTES=60

# ── Langfuse (LLM Tracing) ────────────────────────────────────────────────────
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"
LANGFUSE_NEXTAUTH_SECRET=change_me_nextauth_secret
LANGFUSE_SALT=change_me_salt_value
# Obtain from Langfuse UI after first login (Settings > API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
